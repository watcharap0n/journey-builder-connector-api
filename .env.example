APP_NAME="Journey Builder API"
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# AWS RDS credentials are loaded from this Secrets Manager entry.
# Expected JSON:
# {"host":"...","port":5432,"username":"...","password":"...","dbname":"postgres"}
AWS_REGION=ap-southeast-1
SECRET_ID=

# Optional direct override for tests or local development only.
# DATABASE_URL=postgresql+asyncpg://user:password@rds-host:5432/postgres
# With APP_ENV=local, a secret/URL using host.docker.internal is kept inside
# containers and mapped to 127.0.0.1 for host-run commands such as Alembic.

# Docker Compose overrides this hostname to the redis service.
REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=journey-builder
CACHE_DEFAULT_TTL_SECONDS=300
# Connector control plane. Queue/Scheduler values are CloudFormation outputs
# from the connector runtime CDK stack.
CONNECTOR_SECRET_PREFIX=connector
CONNECTOR_SECRET_KMS_KEY_ID=
CONNECTOR_DISPATCH_QUEUE_URL=
CONNECTOR_OCCURRENCE_QUEUE_URL=
CONNECTOR_OCCURRENCE_DLQ_ARN=
CONNECTOR_RESULT_QUEUE_URL=
CONNECTOR_SCHEDULER_GROUP=
CONNECTOR_SCHEDULER_ROLE_ARN=
CONNECTOR_RUNTIME_WORKSPACE_ID=
CONNECTOR_WORKER_POLL_SECONDS=10

# Manual Elasticsearch standardization. The source secret is expected to use
# the same host/user/password JSON contract as SECRET_ID; database name is
# selected separately so raw source and warehouse remain distinct databases.
STANDARDIZATION_SOURCE_SECRET_ID=marketing-automation-secret
STANDARDIZATION_SOURCE_DATABASE=elasticsearch
STANDARDIZATION_SOURCE_SSL=true

STANDARDIZATION_DISPATCH_QUEUE_URL=https://sqs.ap-southeast-7.amazonaws.com/538783577018/CdpElasticsearchStandardizationRuntime-DispatchQueue898EB017-6XWzrbPHV0jT
STANDARDIZATION_RESULT_QUEUE_URL=https://sqs.ap-southeast-7.amazonaws.com/538783577018/CdpElasticsearchStandardizationRuntime-ResultQueue98CD34E0-AS9vvfn0EZvV
STANDARDIZATION_WORKER_POLL_SECONDS=10
STANDARDIZATION_STALE_PARTITION_SECONDS=900
